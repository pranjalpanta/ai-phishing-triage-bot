# ===========================================================================
# AI Phishing Triage Bot - example configuration
# Copy to `.env` and fill in ONLY the values you need.
#   cp .env.example .env          (Windows: copy .env.example .env)
# Never commit the real `.env` file.
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO

# --- AI analysis (optional) ------------------------------------------------
# Leave OPENAI_API_KEY empty to run fully deterministic, rules-only triage.
# Any OpenAI-compatible endpoint works.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_TEMPERATURE=0
AI_MAX_INPUT_CHARS=6000

# --- Threat intelligence (optional) ----------------------------------------
# The application runs fine without keys; lookups are then skipped, never faked.
THREAT_INTEL_ENABLED=true
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
TI_TIMEOUT_SECONDS=10
TI_CACHE_TTL_SECONDS=86400
TI_MAX_LOOKUPS=10
TI_MIN_RISK_SCORE=30

# --- Storage ---------------------------------------------------------------
# Defaults to sqlite:///<project>/data/triage.db when unset.
DATABASE_URL=

# --- Parsing limits --------------------------------------------------------
MAX_EMAIL_SIZE_BYTES=5242880
MAX_BATCH_FILES=2000

# --- Risk scoring weights (normalised to 100) ------------------------------
WEIGHT_URL=25
WEIGHT_SENDER=20
WEIGHT_LANGUAGE=15
WEIGHT_DOMAIN=20
WEIGHT_AUTH=10
WEIGHT_AI=10

# --- Decision thresholds ---------------------------------------------------
SUSPICIOUS_THRESHOLD=30
PHISHING_THRESHOLD=60

# --- Dashboard -------------------------------------------------------------
# Point the Streamlit dashboard at a running API instance.
TRIAGE_API_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000
